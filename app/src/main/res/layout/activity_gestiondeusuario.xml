<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_splash"
    tools:context=".Gestiondeusuario">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnVolverGestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="start"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Volver"
            app:tint="@color/text_silver"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gestión de Usuarios"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_silver"
            android:layout_gravity="center"
            android:layout_marginBottom="48dp"/>

        <Button
            android:id="@+id/btnIngresarUsuario"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="Ingresar Usuario"
            android:textSize="18sp"
            android:backgroundTint="@color/primary_navy"
            android:layout_marginBottom="16dp"
            app:icon="@android:drawable/ic_input_add"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/white"
            app:iconTint="@color/white"/>

        <Button
            android:id="@+id/btnListarUsuarios"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="Listar Usuarios"
            android:textSize="18sp"
            android:backgroundTint="@color/primary_navy"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/white"
            app:iconTint="@color/white"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>